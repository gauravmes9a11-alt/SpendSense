# Copy this file to .env and fill in your own values. Never commit .env.
# ── Local development ──────────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=spendsense

# Comma-separated origins allowed to call the API from a browser (local dev)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Vector Embedding Providers (FastEmbed ONNX BAAI/bge-small-en-v1.5 is used by default with 0 API keys required)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...

# ── Vercel (Production) ────────────────────────────────────────────────────────
# Set these as Environment Variables in the Vercel dashboard → Project → Settings → Environment Variables
# MYSQL_HOST=<your-cloud-mysql-host>      e.g. from PlanetScale, Aiven, Railway, etc.
# MYSQL_PORT=3306
# MYSQL_USER=<db-user>
# MYSQL_PASSWORD=<db-password>
# MYSQL_DATABASE=spendsense
# CORS_ORIGINS=https://your-project.vercel.app
